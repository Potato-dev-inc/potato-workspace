{
  "name": "@potato-workspace/cli",
  "version": "0.2.2",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "bin": {
    "potato-workspace": "./dist/index.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node --enable-source-maps dist/index.js",
    "dev": "tsx src/index.ts",
    "test": "tsx --test src/watch.test.ts src/watch-args.test.ts src/pair-link.test.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@potato-workspace/shared": "*"
  },
  "devDependencies": {
    "@types/node": "^22.10.1",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3"
  }
}
