{
  "note": "Words a person must never see on a screen: internal names, raw errors, raw paths. Each rule is a regular expression tested against visible text, title, aria-label and placeholder (the terminal view and chat message bodies written by agents are skipped). `allow` lists exact phrases that are fine even though they match.",
  "rules": [
    { "id": "internal-id", "re": "\\b(pane_id|prompt_id|standby_helper|operation_id|session_id|agent_type)\\b", "flags": "i" },
    { "id": "internal-name-acp", "re": "\\bACP\\b", "flags": "" },
    { "id": "internal-name-puppet", "re": "puppet[-_ ]master", "flags": "i" },
    { "id": "internal-name-worktree", "re": "\\bworktrees?\\b", "flags": "i", "note": "the product says workspace copy" },
    { "id": "js-leak", "re": "\\[object Object\\]|\\bundefined\\b|\\bNaN\\b|\\bnull\\b", "flags": "" },
    { "id": "raw-error", "re": "\\bError:|\\bEISDIR\\b|\\bENOENT\\b|\\bEPERM\\b|\\bEACCES\\b|\\bos error\\b|\\bat Function\\.|\\bpanicked\\b|stack trace|Traceback \\(most recent", "flags": "" },
    { "id": "raw-json", "re": "^\\s*[{\\[]\\s*\"[a-z_]+\"\\s*:", "flags": "i" },
    { "id": "verbatim-path", "re": "\\\\\\\\\\?\\\\", "flags": "" },
    { "id": "raw-http", "re": "\\b(HTTP|status)[ :]+[45]\\d\\d\\b", "flags": "i" }
  ],
  "allow": []
}
