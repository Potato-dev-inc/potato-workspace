# Disposable SSH test host (Debian). SHELL_IS=dash keeps /bin/sh as dash; SHELL_IS=bash makes /bin/sh bash.
FROM node:20-bookworm-slim
ARG SHELL_IS=dash
ARG PUBKEY
RUN apt-get update && apt-get install -y --no-install-recommends openssh-server bash git && rm -rf /var/lib/apt/lists/* \
 && mkdir -p /run/sshd && useradd -m -s /bin/bash tester && echo "tester:*" | chpasswd -e \
 && if [ "$SHELL_IS" = bash ]; then ln -sf /bin/bash /bin/sh; fi \
 && printf 'PasswordAuthentication no\nKbdInteractiveAuthentication no\nPubkeyAuthentication yes\nPermitRootLogin no\nAllowUsers tester\nUsePAM no\n' > /etc/ssh/sshd_config.d/pm.conf
USER tester
RUN mkdir -p ~/.ssh ~/.local/bin && echo "$PUBKEY" > ~/.ssh/authorized_keys && chmod 700 ~/.ssh && chmod 600 ~/.ssh/authorized_keys \
 && printf 'export PATH="$HOME/.local/bin:$PATH"\n' > ~/.profile
COPY --chown=tester:tester claude-agent-acp /home/tester/.local/bin/claude-agent-acp
COPY --chown=tester:tester mk-folders.js /home/tester/mk-folders.js
RUN chmod 755 /home/tester/.local/bin/claude-agent-acp
USER root
EXPOSE 22
CMD ["sh", "-c", "ssh-keygen -A && exec /usr/sbin/sshd -D -e"]
