{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Potato Workspace",
  "version": "1.0.2",
  "identifier": "com.potatodev.workspace",
  "build": {
    "beforeDevCommand": "node ../../scripts/vite-dev.mjs",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "msi"
    ],
    "resources": [
      "resources/mcp-stdio.bundle.cjs",
      "resources/puppet-master-cli.bundle.mjs",
      "resources/pwa-dist/*",
      "resources/pwa-dist/assets/*",
      "resources/bin/*",
      "resources/adapters/**/*",
      "resources/definitions/*.toml",
      "resources/node/**/*",
      "resources/git/**/*",
      "resources/legal/**/*"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "wix": {
        "language": "en-US",
        "upgradeCode": "2e0398e3-228f-4c24-a750-390f8bd522d8"
      },
      "webviewInstallMode": {
        "type": "embedBootstrapper"
      }
    },
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDhFRjUxRUM2RjNENEE4NkMKUldSc3FOVHp4aDcxanB0NjhKaEtIYldTUklOT1Vyd2xKdy9JUGMzNlpVdHc5OFhyR0FqWFZvS3oK",
      "endpoints": [
        "https://github.com/Potato-dev-inc/potato-workspace/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
