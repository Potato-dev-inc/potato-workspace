{
  "$schema": "https://opencode.ai/config.json",
  "theme": "tokyonight",
  "mcp": {
    "potato-workspace": {
      "command": [
        "npx",
        "-y",
        "@potato-workspace/mcp"
      ],
      "enabled": true,
      "environment": {
        "POTATO_WORKSPACE_BRIDGE_PORT_FILE": "C:/pm/potato-workspace.bridge.port"
      },
      "type": "local"
    }
  }
}
