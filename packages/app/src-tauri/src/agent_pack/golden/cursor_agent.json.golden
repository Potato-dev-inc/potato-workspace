{
  "mcpServers": {
    "mine": {
      "command": "my-server"
    },
    "potato-workspace": {
      "args": [
        "-y",
        "@potato-workspace/mcp"
      ],
      "command": "npx",
      "env": {
        "POTATO_WORKSPACE_BRIDGE_PORT_FILE": "C:/pm/potato-workspace.bridge.port"
      }
    }
  }
}
